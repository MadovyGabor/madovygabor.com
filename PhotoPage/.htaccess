Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Enforce HTTPS and canonical host in one redirect.
RewriteCond %{HTTP_HOST} !^photo\.madovygabor\.work$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://photo.madovygabor.work%{REQUEST_URI} [R=301,L,NE]

# Redirect direct .html requests to clean extensionless URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]|$) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Internally map clean URLs back to existing .html files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
