Options -MultiViews -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# 1. HTTPS és Canonical Host kikényszerítése
RewriteCond %{HTTP_HOST} !^photo\.madovygabor\.work$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://photo.madovygabor.work%{REQUEST_URI} [R=301,L,NE]

# 2. Sitemap.xml közvetlen elérése (átugorja a routert)
RewriteRule ^sitemap\.xml$ - [L]

# 3. Csupasz gyökér átirányítása a magyar verzióra
RewriteRule ^$ hu/ [R=302,L]

# 4. Trailing slash (perjel) levágása a fájlok végéről (pl. /hu/portfolio/ -> /hu/portfolio)
# Csak akkor fut le, ha a kérés NEM egy valós mappa
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 5. Clean URLs belső leképezése (pl. /hu/portfolio -> a háttérben /hu/portfolio.html fut)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]