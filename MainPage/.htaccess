Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Normalize direct index.html language entrypoints to canonical directory URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]|$) [NC]
RewriteRule ^index\.html$ https://madovygabor.work/ [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+hu/index\.html(?:[?\s]|$) [NC]
RewriteRule ^hu/index\.html$ https://madovygabor.work/hu/ [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+sk/index\.html(?:[?\s]|$) [NC]
RewriteRule ^sk/index\.html$ https://madovygabor.work/sk/ [R=301,L,NE]

# Enforce HTTPS + non-www canonical host in a single 301 redirect.
RewriteCond %{HTTP_HOST} !^madovygabor\.work$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://madovygabor.work%{REQUEST_URI} [R=301,L,NE]
